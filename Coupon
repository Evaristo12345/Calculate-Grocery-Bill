import java.util.Scanner;

public class GroceryCalculator {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        System.out.print("Enter the coupon amount as a decimal (Example: 0.10 for 10%): ");
	        double coupon = scanner.nextDouble();

			 System.out.print("Enter the coupon amount as a decimal (Example: 0.10 for 10%): ");
	        double coupon = scanner.nextDouble();
	        
	        if (coupon > 1.0 || coupon <= 0.0) {
	            coupon = 0.10;
	            System.out.println("Invalid coupon entered. Defaulting to 10% (0.10).");
	        }
	         double[] weeklyBills = new double[4];
	        double totalWithoutCoupon = 0.0;
	        
	        for (int i = 0; i < 4; i++) {
	            System.out.print("Enter grocery bill for Week " + (i + 1) + ": $");
	            weeklyBills[i] = scanner.nextDouble();
	            totalWithoutCoupon += weeklyBills[i];
	        }
			double averageWeeklyWithoutCoupon = totalWithoutCoupon / 4.0;
	        
	        double totalWithCoupon = totalWithoutCoupon * (1.0 - coupon);
	        double averageWeeklyWithCoupon = totalWithCoupon / 4.0;
	        
			System.out.println("\n--- Grocery Bill Summary (Family of 4) ---");
	        System.out.printf("Coupon Rate Applied: %.1f%%\n\n", (coupon * 100));
	        System.out.println("Without Coupon:");
	        System.out.printf("  Monthly Total:  $%.2f\n", totalWithoutCoupon);
	        System.out.printf("  Weekly Average: $%.2f\n\n", averageWeeklyWithoutCoupon);
	        
	        System.out.println("With Coupon:");
	        System.out.printf("  Monthly Total:  $%.2f\n", totalWithCoupon);
	        System.out.printf("  Weekly Average: $%.2f\n", averageWeeklyWithCoupon);
	        
	        scanner.close();
	    }
}
